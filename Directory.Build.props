<Project>
    <PropertyGroup>
        <!-- Keep the build machine's folder path out of the compiled files (debug path) -->
        <PathMap>$(MSBuildThisFileDirectory)=/src/</PathMap>
    </PropertyGroup>
    <!-- Enables building net462 on a machine without Visual Studio installed -->
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>
</Project>
